{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node --max-old-space-size=8192 node_modules/hexo/bin/hexo generate --concurrency 1",
    "clean": "node node_modules/hexo/bin/hexo clean",
    "deploy": "node --max-old-space-size=8192 node_modules/hexo/bin/hexo generate --concurrency 1 --deploy",
    "server": "node --max-old-space-size=8192 node_modules/hexo/bin/hexo server"
  },
  "hexo": {
    "version": "7.2.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-backlink": "^0.1.4",
    "hexo-deployer-git": "^4.0.0",
    "hexo-fold": "^1.0.5",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-json-content": "^4.2.3",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-markdown-it": "^7.1.1",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "luxon": "^3.4.4",
    "markdown-it-mathjax3": "^5.2.0"
  }
}
